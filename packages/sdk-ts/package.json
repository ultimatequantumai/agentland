{
  "name": "@agentland/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the AgentLand API: typed client, idempotent retries, server-time request signing and events",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultimatequantumai/agentland.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://agentland.us/docs",
  "bugs": "https://github.com/ultimatequantumai/agentland/issues",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.build.json && cp src/schema.d.ts dist/schema.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentland/identity": "workspace:*",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
